generator client {
  provider = "prisma-client"
  output = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Users {
  id              String   @id @default(uuid())
  wallet_address  String   @unique
  email           String   @unique
  password_hash   String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  missions        Mission[]
  submissions     Submission[]
  reputation      Reputation
  challenges      Challenge[]
}

model Wallets {
  id          String   @id @default(uuid())
  address     String   @unique
  signature   String
  verified    Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  missions      Mission[]
  submissions   Submission[]
}

model Missions {
  id                String   @id @default(uuid())
  title             String
  description       String?
  claim             String
  verification_rules String
  required_source_types String
  reward            String
  currency          String
  creator           String
  difficulty        String
  required_evidence String
  status            String   @default("DRAFT")
  deadline          DateTime
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  creator_wallet    Wallets @relation(fields: [creator_wallet_id], references: [id])
  creator_wallet_id String
  claims            Claim[]
  submissions       Submission[]
  adjudications     Adjudication[]
}

model Claim {
  id               String   @id @default(uuid())
  statement        String
  created_by       String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  status           String   @default("PENDING")
  verification_rules String
  required_source_types String
  deadline         DateTime
  reward_amount    String
  currency         String
  mission_id       String
  mission          Mission? @relation(fields: [mission_id], references: [id])
  mission_id      String?
  current_verdict  String   @default("PENDING")
  adjudication_reference String?
  version          Int      @default(1)
  evidence         Evidence[]
  versions         ClaimVersion[]
}

model ClaimVersion {
  id         String   @id @default(uuid())
  claim      Claim    @relation(fields: [claim_id], references: [id])
  claim_id   String
  version    Int
  status     String
  created_at DateTime @default(now())
  created_by String
}

model Evidence {
  id              String   @id @default(uuid())
  url             String
  title           String
  description     String
  quoted_passage  String
  submitted_at    DateTime @default(now())
  screenshot      String?
  source_type     String
  submitter       String
  mission_id      String
  mission         Mission? @relation(fields: [mission_id], references: [id])
  mission_id     String?
  claim_id        String
  claim          Claim? @relation(fields: [claim_id], references: [id])
  claim_id      String?
  status          String   @default("PENDING_ADJUDICATION")
  adjudication_id String?
  transaction_ref String?
  adjudication    Adjudication?
}

model Adjudication {
  id               String   @id @default(uuid())
  claim_id         String
  claim            Claim    @relation(fields: [claim_id], references: [id])
  evidence_id      String
  evidence         Evidence @relation(fields: [evidence_id], references: [id])
  verdict          String
  reason           String
  evidence_assessment String
  source_quality   String
  timestamp        DateTime @default(now())
  adjudication_ref String?
  transaction_hash String?
}

model Reputation {
  id              String   @id @default(uuid())
  user_id         String   @unique
  user            Users    @relation(fields: [user_id], references: [id])
  verified_submissions Int   @default(0)
  rejected_submissions Int   @default(0)
  accuracy        Float    @default(0.0)
  successful_challenges Int   @default(0)
  missions_completed Int   @default(0)
  total_earned    String   @default("0")
  current_streak  Int      @default(0)
  best_streak     Int      @default(0)
  last_verified_at DateTime?
  last_rewarded_at DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model Reward {
  id              String   @id @default(uuid())
  claim_id        String
  claim           Claim    @relation(fields: [claim_id], references: [id])
  amount          String
  currency        String
  status          String   @default("HELD")
  transaction_hash String?
  settled_at      DateTime?
  created_at      DateTime @default(now())
}

model Challenge {
  id              String   @id @default(uuid())
  claim_id        String
  claim           Claim    @relation(fields: [claim_id], references: [id])
  challenger      String
  reason          String
  new_evidence_id String?
  status          String   @default("PENDING")
  created_at      DateTime @default(now())
  re_adjudicated_at DateTime?
  new_verdict     String?
}
