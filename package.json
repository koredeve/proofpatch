{
  "name": "proofpatch",
  "version": "0.1.0",
  "description": "Decentralized evidence-verification marketplace adjudicated on GenLayer",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node server.js",
    "migrate": "node scripts/migrate.js",
    "db:test:reset": "./scripts/test-db.sh",
    "seed": "node scripts/seed.js",
    "test": "./scripts/test-db.sh && node --test tests/unit.test.mjs tests/integration.test.mjs tests/security.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:integration": "npm run db:test:reset && node --test tests/integration.test.mjs",
    "test:security": "npm run db:test:reset && node --test tests/security.test.mjs",
    "agent:example": "node agents/example-agent.mjs",
    "build": "cd frontend && npm run build",
    "start": "node server.js"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "@noble/secp256k1": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "viem": "^2.43.1",
    "zod": "^4.1.13"
  }
}