# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://user:password@localhost:5432/proofpatch

# ---- Auth ----
# 32+ random bytes. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
RATE_LIMIT_PER_10MIN=30

# ---- Server ----
PORT=3001

# ---- GenLayer adjudication (OPTIONAL but recommended) ----
# When ALL THREE are set, adjudications execute on-chain through the deployed
# ClaimVerifier Intelligent Contract (real consensus + real transaction hashes).
# When absent, the app runs in LOCAL-SIMULATION mode and every result is labeled
# SIMULATED in the API and UI. No hashes or consensus data are ever fabricated.
#
# Get testnet funds/keys via https://docs.genlayer.com (Bradbury testnet faucet).
GENLAYER_RPC_URL=
GENLAYER_CONTRACT_ADDRESS=
GENLAYER_PRIVATE_KEY=
GENLAYER_CHAIN=testnetBradbury   # testnetBradbury | localnet

# ---- Economy ----
# Protocol take rate on released mission rewards, basis points (1000 = 10%, max 2000).
PROTOCOL_FEE_BPS=1000
# GEN bond required to challenge a verified claim (0 disables bonding).
CHALLENGE_BOND_GEN=20
# When '1', creating a mission escrows the reward from the creator's earned balance,
# making the ledger internally conserved (recommended for production economy).
REQUIRE_CREATOR_ESCROW=0
